# Copy this file to .env and fill in real values before running/deploying

# Port the API server listens on
PORT=5000

# Secret used to sign JWT auth tokens - CHANGE THIS to a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# How long a login session lasts
JWT_EXPIRES_IN=12h

# The very first admin account (created automatically the first time the
# server starts, only if no admin exists yet in data/db.json)
BOOTSTRAP_ADMIN_ID=ADMIN001
BOOTSTRAP_ADMIN_EMAIL=admin@yourcollege.edu
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@123

# Multi-college: on the first start after upgrading, existing teachers and
# students (from before colleges existed) are moved into this college. You can
# rename it later from Admin -> Colleges. Short name = roll-number prefix.
LEGACY_COLLEGE_NAME=My College
LEGACY_COLLEGE_SHORT=MC

# Comma separated list of origins allowed to call this API (your frontend URL(s))
# Example: https://yourquizapp.vercel.app,http://localhost:5500
CORS_ORIGIN=*

# MongoDB Atlas connection string (Database > Connect > Drivers > Node.js).
# Replace <db_password> with your real database user's password, and make
# sure the database user has "Read and write to any database" privileges.
# In Atlas > Network Access, add 0.0.0.0/0 so your host (e.g. Render) can connect.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/proctored_quiz?retryWrites=true&w=majority&appName=Cluster0


# ---- Forgot password by email (6-digit code) -------------------------------
# Set up ONE of the two options below. Without either, "Forgot password?"
# on the login page tells users that email reset isn't set up yet.
#
# The address emails come from (must be a verified sender for Brevo)
MAIL_FROM="Classroom <yourname@gmail.com>"
#
# Option 1 (recommended on Render, works over HTTPS): Brevo free plan.
# brevo.com -> SMTP & API -> API keys -> create key; Senders -> verify MAIL_FROM
BREVO_API_KEY=
#
# Option 2: any SMTP server, e.g. Gmail with an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# Local testing only: print the code in the server console instead of emailing
MAIL_DEV_LOG=false
